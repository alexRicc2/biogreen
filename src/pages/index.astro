---
import BiogreenApp from '../components/BiogreenApp';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="BIOGREEN — interactive quantitative green chemistry metric for circular bioeconomy materials. Compare proposed synthesis routes against baselines with a 12-criterion weighted score and radar pictogram."
    />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="BIOGREEN Sustainability Assessment Platform" />
    <meta
      property="og:description"
      content="Score and compare bio-based material synthesis routes with the BIOGREEN metric: 12 weighted criteria, live pictogram, and exportable reports."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>BIOGREEN — Circular Bioeconomy Material Metric</title>
  </head>
  <body>
    <BiogreenApp client:load />
  </body>
</html>
